# ─── Base de données SQLite ───────────────────────────────────────────────────
# Chemin du fichier SQLite à l'intérieur du conteneur (volume Docker)
DATABASE_URL="file:/app/data/guardian.db"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Génère une valeur aléatoire solide : openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-secret"

# ─── Bungie OAuth / API ───────────────────────────────────────────────────────
# Récupère ces valeurs sur https://www.bungie.net/en/Application
BUNGIE_API_KEY="your_bungie_api_key"
CLIENT_ID="your_bungie_client_id"
CLIENT_SECRET="your_bungie_client_secret"

# ─── URLs ─────────────────────────────────────────────────────────────────────
# URL du frontend (utilisée pour la redirection OAuth Bungie)
FRONTEND_URL="https://TON_DOMAINE"

# URL de l'API backend appelée par le frontend (injectée au build Vite)
VITE_API_URL="https://TON_DOMAINE"
